# ---------------------------------------------------------------------
# DeepSeek Harness Router - local environment
#
# This file is the ONE place host-specific values live.
# It is gitignored. Commit only .env.example.
#
# The launcher regenerates this file on every start, so edits here are
# a reference, not a source of truth.
# ---------------------------------------------------------------------

# Absolute path to the project directory to expose to the agent.
# Mounted read-write at /workspace inside the container.
#   Windows : C:/Users/you/projects/my-app
#   macOS   : /Users/you/projects/my-app
#   Linux   : /home/you/projects/my-app
WORKSPACE_PATH=

# Host port the Web UI is published on.
# Default 3080. The launcher selects the next free port if it is taken.
APP_PORT=3080

# Log verbosity: error | warn | info | debug | trace
LOG_LEVEL=info

# Named Compose project. Change it to run more than one instance
# on a single machine; every container, volume, and network is
# namespaced by this value.
COMPOSE_PROJECT_NAME=deepseek-harness-router

# Publish address. Keep 127.0.0.1 to restrict the UI to this machine.
# Setting 0.0.0.0 REQUIRES TRUSTED_HOSTS, and the launcher enforces that.
BIND_ADDR=127.0.0.1

# Extra hostnames the UI may be reached by (comma-separated).
# Only needed when the UI is NOT reached via 127.0.0.1.
#   Example: 192.168.1.50,my-dev-box.local
TRUSTED_HOSTS=

# Open the browser after a successful start: true | false
OPEN_BROWSER=true

# Image tag to run. Pin this for reproducible deployments.
ROUTER_IMAGE=deepseek-harness-router:1.0.0

# Exact DeepSeek Harness version baked into the image.
# Must match docs/dsh-compatibility.md.
DSH_VERSION=0.1.5-rc.1

# NOTE: no API key belongs in this file.
# Configure the model in the UI (Settings > Models), which stores it in
# the instance's own credential store under its state root.
