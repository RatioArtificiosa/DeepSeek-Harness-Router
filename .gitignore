# ─────────────────────────────────────────────────────────────────────
# DeepSeek Harness Router — repository ignore rules
# ─────────────────────────────────────────────────────────────────────

# ── WORKING PLANS ────────────────────────────────────────────────────
# The architecture proposal and execution checklist are authoring
# documents for this machine, not published repository content.
# They stay on disk and out of every commit.
PROPOSAL.md
CHECKLIST.md

# ── PRIVATE INSTALLER ────────────────────────────────────────────────
# The owner's personal installation tooling is deliberately absent
# from this repository.
installer/
*.local.md
*.local.ps1
*.local.sh
router-image.tar
router-image.tar.gz
checksums.local.txt

# ── LOCAL ENVIRONMENT ────────────────────────────────────────────────
# Contains absolute paths from this machine. Never commit.
.env
.env.local
.env.*.local
!.env.example

# ── RUNTIME STATE ────────────────────────────────────────────────────
/data/
/workspace/
*.log
logs/

# ── RUST ─────────────────────────────────────────────────────────────
target/
**/target/
# Cargo.lock IS committed: this workspace produces a binary, so the
# lockfile is the reproducibility contract.

# ── NODE (build tooling only; the runtime never needs it) ────────────
node_modules/
**/node_modules/
.pnpm-store/

# ── EDITORS AND OS ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── BUILD ARTIFACTS ──────────────────────────────────────────────────
dist/
build/
*.tar
*.tar.gz
